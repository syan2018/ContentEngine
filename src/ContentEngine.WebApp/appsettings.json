{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "LiteDbOptions": {
    "DatabasePath": "ContentEngine_Data.db" 
  },
  "MarkItDownApi": {
    "BaseUrl": "http://localhost:8000"
  },
  "EnforceHttps": false,
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:8264"
      }
    }
  },
  "ReverseProxy": {
    "KnownProxies": [ "127.0.0.1" ]
  }
}

@using ContentEngine.Core.Inference.Models
@using ContentEngine.Core.Inference.Services
@using Microsoft.AspNetCore.SignalR.Client
@implements IAsyncDisposable
@inject IReasoningProgressManager ProgressManager
@inject NavigationManager Navigation

@if (progress != null)
{
    <MudStack Spacing="@(Compact ? 1 : 2)">
        @if (!HideLabel)
        {
            <MudGrid>
                <MudItem xs="8">
                    <MudText Typo="@(Compact ? Typo.caption : Typo.body2)">
                        @progress.GetStatusDisplayText()
                    </MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        @progress.GetDetailedProgressText()
                    </MudText>
                </MudItem>
                @if (ShowCost && progress.TotalCost > 0)
                {
                    <MudItem xs="4" Class="text-right">
                        <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Text">
                            $@progress.TotalCost.ToString("F3")
                        </MudChip>
                    </MudItem>
                }
            </MudGrid>
        }
        
        <MudProgressLinear Color="@GetProgressColor()" 
                          Striped="@progress.IsActive" 
                          Size="@Size"
                          Value="@GetFinalizedProgress()" />
        
        @if (ShowDetails && !Compact)
        {
            <MudStack Row Spacing="1" Wrap="Wrap.Wrap">
                @if (progress.ExecutingCount > 0)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Icon="@Icons.Material.Filled.PlayArrow" Variant="Variant.Text">
                        执行中 @progress.ExecutingCount
                    </MudChip>
                }
                @if (progress.QueueingCount > 0)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Info" Icon="@Icons.Material.Filled.Queue" Variant="Variant.Text">
                        排队中 @progress.QueueingCount
                    </MudChip>
                }
                @if (progress.PendingCount > 0)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Default" Icon="@Icons.Material.Filled.Schedule" Variant="Variant.Text">
                        待处理 @progress.PendingCount
                    </MudChip>
                }
                @if (progress.FailedCount > 0)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Error" Icon="@Icons.Material.Filled.Error" Variant="Variant.Text">
                        失败 @progress.FailedCount
                    </MudChip>
                }
            </MudStack>
        }
    </MudStack>
}
else if (IsLoading)
{
    <MudStack Spacing="@(Compact ? 1 : 2)">
        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="@(Compact ? "16px" : "24px")" />
        @if (!Compact)
        {
            <MudSkeleton SkeletonType="SkeletonType.Text" />
        }
    </MudStack>
}
else
{
    <MudText Typo="Typo.caption" Color="Color.Secondary" Align="Align.Center">
        暂无进度信息
    </MudText>
}

@* 使用MudBlazor原生样式，无需自定义CSS *@

@code {
    [Parameter] public string InstanceId { get; set; } = string.Empty;
    [Parameter] public bool Compact { get; set; } = false;
    [Parameter] public bool ShowDetails { get; set; } = true;
    [Parameter] public bool ShowCost { get; set; } = true;
    [Parameter] public bool HideLabel { get; set; } = false;
    [Parameter] public Size Size { get; set; } = Size.Medium;
    [Parameter] public bool IsLoading { get; set; } = false;
    
    private ReasoningProgress? progress;
    private HubConnection? hubConnection;
    private string? currentInstanceId;
    private bool _isDisposed = false;
    private readonly SemaphoreSlim _initLock = new SemaphoreSlim(1, 1);
    private readonly CancellationTokenSource _cts = new CancellationTokenSource();

    protected override async Task OnInitializedAsync()
    {
        await InitializeAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        // 如果实例ID发生变化，需要重新订阅
        if (currentInstanceId != InstanceId)
        {
            await ResubscribeToInstance();
        }
    }

    private async Task InitializeAsync()
    {
        if (_isDisposed) return;

        // 初始加载进度
        await LoadProgressAsync();
        
        // 初始化 SignalR 连接
        await InitializeSignalRConnection();
        
        // 订阅当前实例
        await SubscribeToCurrentInstance();
    }

    private async Task LoadProgressAsync()
    {
        if (string.IsNullOrEmpty(InstanceId))
            return;
            
        try
        {
            IsLoading = true;
            progress = await ProgressManager.GetProgressAsync(InstanceId);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"加载进度失败: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task InitializeSignalRConnection()
    {
        if (_isDisposed) return;

        await _initLock.WaitAsync();
        try
        {
            if (_isDisposed) return;

            // 若已存在并连接则跳过
            if (IsHubConnected()) return;

            // 如果有旧连接先清理
            if (hubConnection != null)
            {
                try { await hubConnection.DisposeAsync(); } catch { }
                hubConnection = null;
            }

            var connection = new HubConnectionBuilder()
                .WithUrl(Navigation.ToAbsoluteUri("/reasoning-progress-hub"))
                .Build();

            // 订阅进度更新事件
            connection.On<string, ReasoningProgress>("ProgressUpdated", OnProgressUpdated);
            connection.On<string, TransactionStatus, TransactionStatus>("StatusChanged", OnStatusChanged);

            try
            {
                await connection.StartAsync(_cts.Token);
                hubConnection = connection;
            }
            catch (Exception startEx)
            {
                // 启动失败则释放连接并回退到本地事件
                try { await connection.DisposeAsync(); } catch { }
                hubConnection = null;

                Console.WriteLine($"SignalR连接失败，回退到事件订阅: {startEx.Message}");
                ProgressManager.ProgressUpdated += OnLocalProgressUpdated;
            }
        }
        finally
        {
            _initLock.Release();
        }
    }

    private async Task SubscribeToCurrentInstance()
    {
        if (_isDisposed) return;

        if (IsHubConnected() && !string.IsNullOrEmpty(InstanceId))
        {
            try
            {
                var conn = hubConnection; // 局部引用，避免并发置空
                if (conn != null)
                {
                    await conn.SendAsync("SubscribeToInstance", InstanceId, _cts.Token);
                    currentInstanceId = InstanceId;
                }
            }
            catch (ObjectDisposedException)
            {
                // 已经释放，忽略
            }
            catch (Exception ex)
            {
                Console.WriteLine($"订阅实例失败: {ex.Message}");
            }
        }
    }

    private async Task ResubscribeToInstance()
    {
        if (_isDisposed) return;

        if (IsHubConnected())
        {
            try
            {
                var conn = hubConnection; // 局部引用
                if (conn != null)
                {
                    // 取消旧的订阅
                    if (!string.IsNullOrEmpty(currentInstanceId))
                    {
                        await conn.SendAsync("UnsubscribeFromInstance", currentInstanceId, _cts.Token);
                    }

                    // 订阅新的实例
                    await SubscribeToCurrentInstance();
                    
                    // 加载新实例的进度
                    await LoadProgressAsync();
                }
            }
            catch (ObjectDisposedException)
            {
                // 已释放，忽略
            }
            catch (Exception ex)
            {
                Console.WriteLine($"重新订阅实例失败: {ex.Message}");
            }
        }
    }

    private async Task OnProgressUpdated(string instanceId, ReasoningProgress updatedProgress)
    {
        if (instanceId == InstanceId)
        {
            progress = updatedProgress;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task OnStatusChanged(string instanceId, TransactionStatus oldStatus, TransactionStatus newStatus)
    {
        if (instanceId == InstanceId && progress != null)
        {
            progress.Status = newStatus;
            await InvokeAsync(StateHasChanged);
        }
    }

    // 本地事件订阅的回退处理
    private async void OnLocalProgressUpdated(string instanceId, ReasoningProgress updatedProgress)
    {
        if (instanceId == InstanceId)
        {
            progress = updatedProgress;
            await InvokeAsync(StateHasChanged);
        }
    }

    private Color GetProgressColor()
    {
        if (progress == null)
            return Color.Default;
            
        // 基于真实的执行状态判断颜色
        if (progress.IsActive) // 真正在执行
            return Color.Primary;
            
        return progress.Status switch
        {
            TransactionStatus.Completed => Color.Success,
            TransactionStatus.Failed => Color.Error,
            TransactionStatus.FetchingData or TransactionStatus.CombiningData => Color.Info,
            TransactionStatus.Paused => Color.Warning,
            TransactionStatus.GeneratingOutputs when progress.CanContinue => Color.Warning, // 可继续但暂停
            _ => Color.Default
        };
    }

    // 只以“完成（成功+失败）/总数”为准返回进度
    private double GetFinalizedProgress()
    {
        if (progress == null || progress.TotalCombinations <= 0) return 0;
        var finalized = progress.CompletedCount + progress.FailedCount;
        var pct = (double)finalized / progress.TotalCombinations * 100.0;
        if (pct < 0) pct = 0;
        if (pct > 100) pct = 100;
        return pct;
    }

    public async ValueTask DisposeAsync()
    {
        _isDisposed = true;
        _cts.Cancel();

        // 清理本地事件订阅
        ProgressManager.ProgressUpdated -= OnLocalProgressUpdated;
        
        // 清理 SignalR 连接
        var conn = hubConnection;
        hubConnection = null;
        if (conn is not null)
        {
            try
            {
                if (conn.State == HubConnectionState.Connected && !string.IsNullOrEmpty(currentInstanceId))
                {
                    await conn.SendAsync("UnsubscribeFromInstance", currentInstanceId);
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"取消订阅失败: {ex.Message}");
            }
            finally
            {
                try { await conn.DisposeAsync(); } catch { }
            }
        }
    }

    private bool IsHubConnected()
    {
        try
        {
            return hubConnection != null && hubConnection.State == HubConnectionState.Connected;
        }
        catch (ObjectDisposedException)
        {
            return false;
        }
    }
}

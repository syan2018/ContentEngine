@using ContentEngine.Core.DataPipeline.Models
@using ContentEngine.Core.Utils

@if (ShowCard)
{
    <MudCard Outlined="true" Class="@CardClass">
        @if (!string.IsNullOrEmpty(Title))
        {
            <MudCardHeader>
                <CardHeaderContent>
                    <div class="d-flex align-center">
                        <MudText Typo="Typo.subtitle1">@Title</MudText>
                        @if (HasEnhancedPrompt)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Success" Class="ml-2">结构化输出</MudChip>
                        }
                    </div>
                </CardHeaderContent>
            </MudCardHeader>
        }
        <MudCardContent Class="pa-3">
            @PromptContent
        </MudCardContent>
    </MudCard>
}
else
{
    @PromptContent
}

@code {
    [Parameter] public string OriginalPrompt { get; set; } = string.Empty;
    [Parameter] public List<FieldDefinition>? OutputFields { get; set; }
    [Parameter] public bool ShowCard { get; set; } = true;
    [Parameter] public string? Title { get; set; } = "Prompt 内容";
    [Parameter] public bool ShowTabs { get; set; } = true;
    [Parameter] public bool ShowStatistics { get; set; } = true;
    [Parameter] public string CardClass { get; set; } = "";
    
    private bool HasEnhancedPrompt => OutputFields?.Any() == true && !string.IsNullOrEmpty(OriginalPrompt);
    
    private string? EnhancedPrompt => HasEnhancedPrompt 
        ? JsonParsingUtils.BuildEnhancedPrompt(OriginalPrompt, OutputFields!) 
        : null;
    
    private RenderFragment PromptContent => @<div class="prompt-content-container">
        @if (HasEnhancedPrompt && ShowTabs)
        {
            <MudTabs Elevation="0" Rounded="false" Centered="false" Class="prompt-display-tabs">
                <MudTabPanel Text="增强后的Prompt" Icon="@Icons.Material.Filled.AutoFixHigh">
                    <div class="mt-3">
                        <pre class="prompt-content enhanced">@EnhancedPrompt</pre>
                        @if (ShowStatistics)
                        {
                            <div class="prompt-stats mt-3">
                                <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Text">
                                    字符数: @(EnhancedPrompt?.Length ?? 0)
                                </MudChip>
                                <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Text">
                                    行数: @(EnhancedPrompt?.Split('\n').Length ?? 0)
                                </MudChip>
                                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text">
                                    增强: +@((EnhancedPrompt?.Length ?? 0) - OriginalPrompt.Length) 字符
                                </MudChip>
                            </div>
                        }
                    </div>
                </MudTabPanel>
                
                <MudTabPanel Text="原始Prompt" Icon="@Icons.Material.Filled.TextSnippet">
                    <div class="mt-3">
                        <pre class="prompt-content original">@OriginalPrompt</pre>
                        @if (ShowStatistics)
                        {
                            <div class="prompt-stats mt-3">
                                <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Text">
                                    字符数: @OriginalPrompt.Length
                                </MudChip>
                                <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Text">
                                    行数: @OriginalPrompt.Split('\n').Length
                                </MudChip>
                            </div>
                        }
                    </div>
                </MudTabPanel>
            </MudTabs>
        }
        else
        {
            <pre class="prompt-content">@OriginalPrompt</pre>
            @if (ShowStatistics)
            {
                <div class="prompt-stats mt-3">
                    <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Text">
                        字符数: @OriginalPrompt.Length
                    </MudChip>
                    <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Text">
                        行数: @OriginalPrompt.Split('\n').Length
                    </MudChip>
                </div>
            }
        }
    </div>;
}

<style>
.prompt-content-container {
    width: 100%;
}

.prompt-content {
    white-space: pre-wrap;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    line-height: 1.6;
    margin: 0;
    max-height: 400px;
    overflow-y: auto;
    padding: 12px;
    border-radius: 4px;
    background-color: #fafafa;
}

.prompt-content.enhanced {
    background-color: #f0f7ff;
    border-left: 4px solid #1976d2;
}

.prompt-content.original {
    background-color: #fafafa;
    border-left: 4px solid #666;
}

.prompt-stats {
    display: flex;
    gap: 8px;
    align-items: center;
    flex-wrap: wrap;
}

.prompt-display-tabs {
    min-height: 300px;
}

/* 响应式设计 */
@@media (max-width: 768px) {
    .prompt-content {
        font-size: 0.8rem;
        max-height: 250px;
    }
    
    .prompt-stats {
        font-size: 0.75rem;
    }
}
</style>

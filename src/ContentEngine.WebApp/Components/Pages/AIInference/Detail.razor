@page "/ai-inference/detail/{TaskId}"
@using ContentEngine.Core.Inference.Services
@using ContentEngine.Core.Inference.Models
@using ContentEngine.Core.Inference.Utils
@using ContentEngine.Core.Utils
@using ContentEngine.WebApp.Components.Pages.AIInference.Shared
@using ContentEngine.WebApp.Components.Pages.AIInference.Shared.Dialogs
@using ContentEngine.WebApp.Components.Shared
@using Microsoft.AspNetCore.SignalR.Client
@inject IReasoningDefinitionService ReasoningDefinitionService
@inject IReasoningInstanceService ReasoningInstanceService
@inject IReasoningExecutionService ReasoningExecutionService
@inject IReasoningCombinationService ReasoningCombinationService
@inject IReasoningProgressManager ProgressManager
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<link href="Shared/AIInferenceStyles.css" rel="stylesheet" />

<PageTitle>@(definition?.Name ?? "推理实例详情") - ContentEngine</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-4">
    <!-- 统一的面包屑导航 -->
    <PageBreadcrumb Page="PageBreadcrumb.PageType.AIInferenceDetail" 
                   TaskName="@(definition?.Name ?? $"实例 {SafeShortId(instance?.InstanceId)}...")" 
                   TaskId="@TaskId" />

    @if (isLoading)
    {
        <div class="loading-center">
            <MudProgressCircular Indeterminate="true" Size="Size.Large" />
            <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mt-3">
                正在加载任务详情...
            </MudText>
        </div>
    }
    else if (instance == null)
    {
        <MudAlert Severity="Severity.Error">
            推理实例不存在或已被删除
        </MudAlert>
    }
    else
    {
        <!-- 任务头部信息 -->
        <TaskHeaderCard Instance="@instance"
                       Definition="@definition"
                       IsExecuting="@isExecuting"
                       OnExecute="ExecuteTask"
                       OnCopy="CopyTask"
                       OnEdit="EditTask" />

        <!-- 详情标签页 -->
        <MudTabs @bind-ActivePanelIndex="activeTab" Elevation="2" Rounded="true" ApplyEffectsToContainer="true" Class="mb-4">
            <MudTabPanel Text="任务概览" Icon="@Material.Filled.Dashboard">
                @if (definition != null)
                {
                    <TaskOverviewTab Definition="@definition" Instance="@instance" />
                }
            </MudTabPanel>
            
            <MudTabPanel Text="推理请求" Icon="@Material.Filled.DataArray">
                <CombinationTableView 
                    Combinations="@realTimeCombinations"
                    Outputs="@(instance.Outputs)"
                    InstanceId="@instance.InstanceId"
                    IsLoadingCombinations="@isLoadingCombinations"
                    IsCompactView="@isCompactView"
                    HasCachedCombinations="@(instance.InputCombinations?.Any() == true && instance.InputCombinations.Count == realTimeCombinations.Count)"
                    HasQueryDefinitions="@(definition?.QueryDefinitions?.Any() == true)"
                    PromptTemplate="@definition?.PromptTemplate?.TemplateContent"
                    OnRefreshCombinations="RefreshCombinations"
                    OnViewModeChanged="HandleViewModeChanged"
                    OnExecuteCombination="ExecuteCombination"
                    OnPromptPreview="ShowPromptPreview"
                    OnViewResult="ViewCombinationResult"
                    OnRetryCombination="RetryCombination"
                    OnBatchExecute="BatchExecuteCombinations"
                    OnBatchRetry="BatchRetryCombinations"
                    OnExportResults="ExportResults" />
            </MudTabPanel>
        </MudTabs>
    }
</MudContainer>

<style>
.loading-center {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 4rem;
    text-align: center;
}
</style>

@code {
    [Parameter] public string TaskId { get; set; } = string.Empty;
    
    private ReasoningTransactionInstance? instance;
    private ReasoningTransactionDefinition? definition;
    private bool isLoading = true;
    private bool isExecuting = false;
    private int activeTab = 0;
    private bool isLoadingCombinations = false;
    private List<ReasoningInputCombination> realTimeCombinations = new();
    private bool isCompactView = false;
    
    // SignalR 连接
    private HubConnection? hubConnection;
    private ReasoningProgress? currentProgress;
    private DateTime lastManualRefresh = DateTime.MinValue;

    protected override async Task OnInitializedAsync()
    {
        await LoadInstanceDetail();
        await InitializeSignalRConnection();
    }

    private async Task LoadInstanceDetail()
    {
        isLoading = true;
        try
        {
            instance = await ReasoningInstanceService.GetInstanceByIdAsync(TaskId);
            
            if (instance != null)
            {
                definition = await ReasoningDefinitionService.GetDefinitionByIdAsync(instance.DefinitionId);
                
                if (instance.InputCombinations?.Any() == true)
                {
                    realTimeCombinations = instance.InputCombinations;
                }
                else
                {
                    realTimeCombinations.Clear();
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"加载实例详情失败: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ExecuteTask()
    {
        if (instance == null) return;
        
        isExecuting = true;
        try
        {
            await ReasoningExecutionService.ExecuteTransactionAsync(instance.InstanceId);
            Snackbar.Add("任务已开始执行", Severity.Success);
            
            // 触发进度管理器刷新，而不是手动刷新页面数据
            await RefreshInstanceProgress(instance.InstanceId);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"执行任务失败: {ex.Message}", Severity.Error);
        }
        finally
        {
            isExecuting = false;
        }
    }

    private async Task CopyTask()
    {
        if (definition == null) return;
        
        try
        {
            var copy = new ReasoningTransactionDefinition
            {
                Name = $"{definition.Name} - 副本",
                Description = definition.Description,
                QueryDefinitions = definition.QueryDefinitions.ToList(),
                DataCombinationRules = definition.DataCombinationRules.ToList(),
                PromptTemplate = new PromptTemplateDefinition
                {
                    TemplateContent = definition.PromptTemplate.TemplateContent,
                    ExpectedInputViewNames = definition.PromptTemplate.ExpectedInputViewNames.ToList()
                },
                ExecutionConstraints = new ExecutionConstraints
                {
                    MaxEstimatedCostUSD = definition.ExecutionConstraints.MaxEstimatedCostUSD,
                    MaxExecutionTimeMinutes = definition.ExecutionConstraints.MaxExecutionTimeMinutes,
                    MaxConcurrentAICalls = definition.ExecutionConstraints.MaxConcurrentAICalls,
                    EnableBatching = definition.ExecutionConstraints.EnableBatching,
                    BatchSize = definition.ExecutionConstraints.BatchSize
                }
            };
            
            var created = await ReasoningDefinitionService.CreateDefinitionAsync(copy);
            var newInstance = await ReasoningInstanceService.CreateInstanceAsync(created.Id);
            
            Snackbar.Add("任务已复制，切换至新任务", Severity.Success);
            Navigation.NavigateTo($"/ai-inference/detail/{newInstance.InstanceId}");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"复制任务失败: {ex.Message}", Severity.Error);
        }
    }

    private async Task EditTask()
    {
        if (definition == null) return;
        Navigation.NavigateTo($"/ai-inference/create?editId={definition.Id}");
        await Task.CompletedTask;
    }

    private async Task RefreshCombinations()
    {
        if (instance == null) return;
        
        if (instance.Outputs?.Any() == true)
        {
            var result = await DialogService.ShowMessageBox(
                "确认重新生成组合",
                "重新生成组合将清空所有现有的输出结果和执行记录，并将实例状态重置为待处理。此操作不可撤销，是否继续？",
                yesText: "确认重新生成", 
                cancelText: "取消");
                
            if (result != true) return;
        }
        
        isLoadingCombinations = true;
        try
        {
            realTimeCombinations = await ReasoningCombinationService.RegenerateAndResetInstanceAsync(instance.InstanceId);
            
            // 触发进度管理器刷新，确保状态变化通过SignalR传播
            await RefreshInstanceProgress(instance.InstanceId);
            
            Snackbar.Add($"输入组合已重新生成，实例状态已重置: {realTimeCombinations.Count} 个组合", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"重新生成输入组合失败: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoadingCombinations = false;
        }
    }

    private async Task HandleViewModeChanged(bool isCompact)
    {
        isCompactView = isCompact;
        await Task.CompletedTask;
    }

    private async Task ExecuteCombination(ReasoningInputCombination combination)
    {
        if (instance == null) return;
        
        try
        {
            var outputItem = await ReasoningCombinationService.ExecuteCombinationAsync(instance.InstanceId, combination.CombinationId);
            Snackbar.Add($"组合 {SafeShortId(combination.CombinationId)}... 已执行{(outputItem.IsSuccess ? "成功" : "失败")}", 
                outputItem.IsSuccess ? Severity.Success : Severity.Error);
            
            // 触发进度管理器刷新
            await RefreshInstanceProgress(instance.InstanceId);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"执行组合失败: {ex.Message}", Severity.Error);
        }


    }

    private async Task ShowPromptPreview(string promptContent)
    {
        var parameters = new DialogParameters
        {
            ["Content"] = promptContent
        };
        
        // 如果启用了结构化输出，添加相关参数
        if (definition?.EnableStructuredJsonOutput == true && definition.OutputFields?.Any() == true)
        {
            parameters["HasStructuredOutput"] = true;
            parameters["OutputFields"] = definition.OutputFields;
        }
        
        await DialogService.ShowAsync<PromptPreviewDialog>("Prompt预览", parameters, new DialogOptions
        {
            MaxWidth = MaxWidth.Large, // 增加宽度以容纳更多内容
            FullWidth = true
        });
    }

    private async Task ViewCombinationResult(ReasoningInputCombination combination)
    {
        if (instance == null) return;
        
        try
        {
            var output = await ReasoningCombinationService.GetOutputForCombinationAsync(instance.InstanceId, combination.CombinationId);
            if (output != null)
            {
                var inputData = new Dictionary<string, object>();
                if (combination.DataMap != null)
                {
                    foreach (var kvp in combination.DataMap)
                    {
                        inputData[kvp.Key] = kvp.Value.AsDocument ?? new LiteDB.BsonDocument();
                    }
                }
                
                // 如果有结构化数据，转换为Dictionary<string, object?>
                Dictionary<string, object?>? structuredFields = null;
                if (output.HasStructuredData && output.StructuredData != null)
                {
                    structuredFields = new Dictionary<string, object?>();
                    foreach (var field in output.StructuredData)
                    {
                        // 将BsonValue转换为可显示的值
                        var value = ConvertBsonValueForDisplay(field.Value);
                        structuredFields[field.Key] = value;
                    }
                }

                // 获取调试信息：原始 Prompt 和输出字段
                string? originalPrompt = null;
                List<ContentEngine.Core.DataPipeline.Models.FieldDefinition>? outputFields = null;
                
                if (definition?.EnableStructuredJsonOutput == true && definition.PromptTemplate?.TemplateContent != null)
                {
                    try
                    {
                        // 填充 Prompt 模板得到原始 Prompt
                        originalPrompt = PromptTemplatingEngine.Fill(definition.PromptTemplate.TemplateContent, combination.DataMap);
                        outputFields = definition.OutputFields;
                    }
                    catch (Exception ex)
                    {
                        // 如果填充失败，至少提供模板
                        originalPrompt = definition.PromptTemplate.TemplateContent;
                        outputFields = definition.OutputFields;
                    }
                }

                await DialogService.ShowAsync<ResultViewDialog>("查看结果", new DialogParameters
                {
                    ["Content"] = output.GeneratedText,
                    ["CombinationId"] = combination.CombinationId,
                    ["InputData"] = inputData,
                    ["Cost"] = output.CostUSD,
                    ["GeneratedAt"] = output.GeneratedAt,
                    ["HasStructuredData"] = output.HasStructuredData,
                    ["StructuredFields"] = structuredFields,
                    ["StructuredDataParseError"] = output.StructuredDataParseError,
                    ["OriginalPrompt"] = originalPrompt,
                    ["OutputFields"] = outputFields
                }, new DialogOptions
                {
                    MaxWidth = MaxWidth.Medium,
                    FullWidth = true
                });
            }
            else
            {
                Snackbar.Add("该组合尚未执行或未产生输出结果", Severity.Info);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"查看结果失败: {ex.Message}", Severity.Error);
        }
    }

    private async Task RetryCombination(ReasoningInputCombination combination)
    {
        if (instance == null) return;
        
        try
        {
            // ✅ 修复：使用专门的重试方法，会正确替换旧的失败结果
            var outputItem = await ReasoningCombinationService.RetryFailedCombinationAsync(instance.InstanceId, combination.CombinationId);
            Snackbar.Add($"组合 {SafeShortId(combination.CombinationId)}... 重试执行{(outputItem.IsSuccess ? "成功" : "失败")}", 
                outputItem.IsSuccess ? Severity.Success : Severity.Error);
            
            // 触发进度管理器刷新，确保状态变化通过SignalR传播
            await RefreshInstanceProgress(instance.InstanceId);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"重试执行失败: {ex.Message}", Severity.Error);
        }
    }

    private async Task BatchExecuteCombinations(List<string> combinationIds)
    {
        await ExecuteBatchOperation(combinationIds, "执行", "确认批量执行");
    }

    private async Task BatchRetryCombinations(List<string> combinationIds)
    {
        await ExecuteBatchOperation(combinationIds, "重试", "确认批量重试");
    }

    private async Task ExecuteBatchOperation(List<string> combinationIds, string operation, string confirmTitle)
    {
        if (instance == null || !combinationIds.Any()) return;
        
        var result = await DialogService.ShowMessageBox(
            confirmTitle,
            $"即将{operation} {combinationIds.Count} 个组合，这可能需要一些时间并产生费用。是否继续？",
            yesText: $"确认{operation}", 
            cancelText: "取消");
            
        if (result != true) return;
        
        try
        {
            isExecuting = true;
            var batchResult = await ReasoningCombinationService.BatchExecuteCombinationsAsync(
                instance.InstanceId, combinationIds, maxConcurrency: 3);
            
            Snackbar.Add($"批量{operation}完成：成功 {batchResult.SuccessfullyExecuted}，失败 {batchResult.Failed}，总成本 ${batchResult.TotalCost:F3}", 
                Severity.Success);
            
            // 触发进度管理器刷新
            await RefreshInstanceProgress(instance.InstanceId);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"批量{operation}失败: {ex.Message}", Severity.Error);
        }
        finally
        {
            isExecuting = false;
        }
    }

    private async Task ExportResults()
    {
        if (instance?.Outputs?.Any() != true)
        {
            Snackbar.Add("暂无结果可导出", Severity.Warning);
            return;
        }
        
        try
        {
            var defaultName = $"ai_inference_results_{SafeShortId(instance.InstanceId)}_{DateTime.Now:yyyyMMdd_HHmmss}";
            var dialog = await DialogService.ShowAsync<ContentEngine.WebApp.Components.Pages.AIInference.Shared.Dialogs.ExportOptionsDialog>("导出选项", new DialogParameters
            {
                ["DefaultFileName"] = defaultName
            }, new DialogOptions
            {
                MaxWidth = MaxWidth.Small,
                FullWidth = true
            });

            var dialogResult = await dialog.Result;
            if (dialogResult == null || dialogResult.Canceled)
            {
                return;
            }

            if (dialogResult.Data == null)
            {
                Snackbar.Add("未获取到导出选项", Severity.Warning);
                return;
            }

            // 动态读取选项，避免编译期类型不一致
            dynamic options = dialogResult.Data;
            string format = options.Format;
            string scope = options.Scope;
            string selectedFileName = options.FileName;
            bool includeBaseColumns = false;
            try { includeBaseColumns = options.IncludeBaseColumns; } catch { }

            var filtered = ((string)scope) switch
            {
                "success" => instance.Outputs.Where(o => o.IsSuccess),
                "failed" => instance.Outputs.Where(o => !o.IsSuccess),
                _ => instance.Outputs.AsEnumerable()
            };

            var records = filtered
                .Select(output => 
                {
                    var record = new ExportRecord
                    {
                        CombinationId = output.InputCombinationId,
                        IsSuccess = output.IsSuccess,
                        GeneratedText = output.GeneratedText,
                        FailureReason = output.FailureReason,
                        Cost = output.CostUSD,
                        GeneratedAt = output.GeneratedAt,
                        InputData = BuildFlattenedInputData(instance, output.InputCombinationId),
                        HasStructuredData = output.HasStructuredData
                    };

                    // 如果有结构化数据，提取字段
                    if (output.HasStructuredData && output.StructuredData != null)
                    {
                        foreach (var field in output.StructuredData)
                        {
                            // 将BsonValue转换为可导出的值
                            var value = ConvertBsonValueForExport(field.Value);
                            record.StructuredFields[field.Key] = value;
                        }
                    }

                    return record;
                })
                .ToList();

            if (records.Count == 0)
            {
                Snackbar.Add("所选范围内暂无记录", Severity.Info);
                return;
            }

            string contentType;
            string fileExt;
            string content;

            switch ((string)format)
            {
                case "csv":
                    contentType = "text/csv";
                    fileExt = ".csv";
                    content = BuildCsv(records, includeBaseColumns: includeBaseColumns);
                    break;
                case "excel":
                    contentType = "application/vnd.ms-excel";
                    fileExt = ".xls";
                    content = BuildExcelHtml(records, includeBaseColumns: includeBaseColumns);
                    break;
                case "md":
                    contentType = "text/markdown";
                    fileExt = ".md";
                    content = BuildMarkdown(records, instance.InstanceId);
                    break;
                default:
                    contentType = "application/json";
                    fileExt = ".json";
                    content = System.Text.Json.JsonSerializer.Serialize(records.Select(r => new
                    {
                        r.CombinationId,
                        r.IsSuccess,
                        r.GeneratedText,
                        r.FailureReason,
                        r.Cost,
                        GeneratedAt = r.GeneratedAt.ToString("yyyy-MM-dd HH:mm:ss"),
                        r.InputData,
                        r.HasStructuredData,
                        StructuredFields = r.HasStructuredData ? r.StructuredFields : null
                    }), new System.Text.Json.JsonSerializerOptions
                    {
                        WriteIndented = true,
                        Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping
                    });
                    break;
            }

            var finalFileName = string.IsNullOrWhiteSpace(selectedFileName) ? defaultName : selectedFileName;
            await JSRuntime.InvokeVoidAsync("downloadFile", $"{finalFileName}{fileExt}", contentType, content);
            
            Snackbar.Add($"结果已导出：{records.Count} 条记录", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"导出失败: {ex.Message}", Severity.Error);
        }
    }

    private string BuildCsv(List<ExportRecord> records, bool includeBaseColumns = true)
    {
        // 收集所有可能的结构化字段名称
        var allStructuredFields = records
            .Where(r => r.HasStructuredData)
            .SelectMany(r => r.StructuredFields.Keys)
            .Distinct()
            .OrderBy(k => k)
            .ToList();

        // 收集所有可能的输入字段：按“视图.字段”展开
        var allInputFields = records
            .Where(r => r.InputData.Count > 0)
            .SelectMany(r => r.InputData.Keys)
            .Distinct()
            .OrderBy(k => k)
            .ToList();

        // 构建表头
        var header = new List<string>();
        if (includeBaseColumns)
        {
            header.AddRange(new []{ "CombinationId", "IsSuccess", "Cost", "GeneratedAt", "FailureReason" });
        }

        if (allInputFields.Any())
        {
            header.AddRange(allInputFields);
        }
        
        // 添加结构化数据字段列
        if (allStructuredFields.Any())
        {
            header.AddRange(allStructuredFields);
        }
        else
        {
            // 如果没有结构化数据，保留原始文本列
            header.Add("GeneratedText");
        }

        var sb = new System.Text.StringBuilder();
        sb.AppendLine(string.Join(",", header));

        foreach (var r in records)
        {
            string Escape(object? v)
            {
                var s = v?.ToString() ?? string.Empty;
                s = s.Replace("\r", string.Empty).Replace("\n", "\\n");
                s = s.Replace("\"", "\"\"");
                return $"\"{s}\"";
            }

            var row = new List<object?>();
            if (includeBaseColumns)
            {
                row.AddRange(new object?[]
                {
                    r.CombinationId,
                    r.IsSuccess,
                    r.Cost,
                    r.GeneratedAt.ToString("yyyy-MM-dd HH:mm:ss"),
                    r.FailureReason ?? string.Empty
                });
            }

            // 统一按 header 中的 allInputFields 顺序出值
            foreach (var fieldName in allInputFields)
            {
                r.InputData.TryGetValue(fieldName, out var v);
                row.Add(v);
            }

            // 添加结构化数据字段值
            if (allStructuredFields.Any())
            {
                foreach (var fieldName in allStructuredFields)
                {
                    var value = r.HasStructuredData && r.StructuredFields.TryGetValue(fieldName, out var fieldValue) 
                        ? fieldValue 
                        : null;
                    row.Add(value);
                }
            }
            else
            {
                // 如果没有结构化数据，添加原始文本
                row.Add(r.GeneratedText);
            }

            sb.AppendLine(string.Join(",", row.Select(v => Escape(v))));
        }

        return sb.ToString();
    }

    // 简易Excel导出：使用HTML表格并以Excel MIME类型下载，或返回Base64字符串内容
    // 为简化依赖，这里返回HTML表格字符串，浏览器保存为.xlsx 仍能被Excel打开（大多数环境兼容）。
    private string BuildExcelHtml(List<ExportRecord> records, bool includeBaseColumns = true)
    {
        // 准备列
        var allStructuredFields = records
            .Where(r => r.HasStructuredData)
            .SelectMany(r => r.StructuredFields.Keys)
            .Distinct()
            .OrderBy(k => k)
            .ToList();

        var allInputFields = records
            .Where(r => r.InputData.Count > 0)
            .SelectMany(r => r.InputData.Keys)
            .Distinct()
            .OrderBy(k => k)
            .ToList();

        var header = new List<string>();
        if (includeBaseColumns)
        {
            header.AddRange(new []{ "CombinationId", "IsSuccess", "Cost", "GeneratedAt", "FailureReason" });
        }
        if (allInputFields.Any()) header.AddRange(allInputFields);
        if (allStructuredFields.Any()) header.AddRange(allStructuredFields); else header.Add("GeneratedText");

        // 生成HTML表格
        var sb = new System.Text.StringBuilder();
        sb.Append("<html><head><meta charset=\"UTF-8\" /></head><body><table border=\"1\" cellspacing=\"0\" cellpadding=\"3\">\n");
        sb.Append("<tr>");
        foreach (var h in header)
        {
            sb.Append("<th>").Append(System.Net.WebUtility.HtmlEncode(h)).Append("</th>");
        }
        sb.Append("</tr>\n");

        foreach (var r in records)
        {
            sb.Append("<tr>");
            void Cell(object? v)
            {
                var s = v?.ToString() ?? string.Empty;
                sb.Append("<td>").Append(System.Net.WebUtility.HtmlEncode(s)).Append("</td>");
            }

            if (includeBaseColumns)
            {
                Cell(r.CombinationId);
                Cell(r.IsSuccess);
                Cell(r.Cost);
                Cell(r.GeneratedAt.ToString("yyyy-MM-dd HH:mm:ss"));
                Cell(r.FailureReason ?? string.Empty);
            }

            foreach (var fieldName in allInputFields)
            {
                r.InputData.TryGetValue(fieldName, out var v);
                Cell(v);
            }

            if (allStructuredFields.Any())
            {
                foreach (var fieldName in allStructuredFields)
                {
                    var value = r.HasStructuredData && r.StructuredFields.TryGetValue(fieldName, out var fieldValue)
                        ? fieldValue : null;
                    Cell(value);
                }
            }
            else
            {
                Cell(r.GeneratedText);
            }

            sb.Append("</tr>\n");
        }

        sb.Append("</table></body></html>");

        // 直接返回HTML文本，前面已将 contentType 设为xlsx，部分浏览器会以xlsx下载；如需100%兼容需引入EPPlus/ClosedXML。
        return sb.ToString();
    }

    // 将组合的 DataMap 展平为 视图.字段 => 值 的字典
    private static Dictionary<string, string> BuildFlattenedInputData(ReasoningTransactionInstance instance, string combinationId)
    {
        var dict = new Dictionary<string, string>();
        var combo = instance.InputCombinations?.FirstOrDefault(c => c.CombinationId == combinationId);
        if (combo?.DataMap == null) return dict;

        foreach (var kvp in combo.DataMap)
        {
            var viewName = kvp.Key;
            var doc = kvp.Value;
            if (doc == null) continue;

            foreach (var field in doc)
            {
                if (field.Key == "_id") continue;
                var key = $"{viewName}.{field.Key}";
                var val = field.Value?.ToString() ?? string.Empty;
                dict[key] = val;
            }
        }
        return dict;
    }

    private string BuildMarkdown(List<ExportRecord> records, string instanceId)
    {
        var sb = new System.Text.StringBuilder();
        sb.AppendLine($"# 推理结果导出 ({SafeShortId(instanceId)})");
        sb.AppendLine($"> 导出时间: {DateTime.Now:yyyy-MM-dd HH:mm:ss}");
        sb.AppendLine();

        foreach (var r in records)
        {
            var inputJson = System.Text.Json.JsonSerializer.Serialize(r.InputData, new System.Text.Json.JsonSerializerOptions { WriteIndented = true, Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping });

            sb.AppendLine($"## 组合 {r.CombinationId}");
            sb.AppendLine($"- 状态: {(r.IsSuccess ? "成功" : "失败")}");
            sb.AppendLine($"- 成本: ${r.Cost}");
            sb.AppendLine($"- 时间: {r.GeneratedAt:yyyy-MM-dd HH:mm:ss}");
            if (!r.IsSuccess && !string.IsNullOrWhiteSpace(r.FailureReason))
                sb.AppendLine($"- 失败原因: {r.FailureReason}");
            sb.AppendLine();
            
            sb.AppendLine("### 输入数据");
            sb.AppendLine("```json");
            sb.AppendLine(inputJson);
            sb.AppendLine("```");
            sb.AppendLine();

            if (r.HasStructuredData && r.StructuredFields.Any())
            {
                sb.AppendLine("### 结构化输出字段");
                sb.AppendLine("| 字段名 | 值 |");
                sb.AppendLine("|--------|-----|");
                
                foreach (var field in r.StructuredFields.OrderBy(kvp => kvp.Key))
                {
                    var value = field.Value?.ToString()?.Replace("|", "\\|").Replace("\n", "<br/>") ?? "";
                    sb.AppendLine($"| {field.Key} | {value} |");
                }
                sb.AppendLine();
                
                sb.AppendLine("### 完整JSON输出");
                sb.AppendLine("```json");
                sb.AppendLine(System.Text.Json.JsonSerializer.Serialize(r.StructuredFields, new System.Text.Json.JsonSerializerOptions 
                { 
                    WriteIndented = true, 
                    Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping 
                }));
                sb.AppendLine("```");
                sb.AppendLine();
            }
            
            sb.AppendLine("### 原始生成内容");
            sb.AppendLine("```");
            sb.AppendLine(r.GeneratedText ?? string.Empty);
            sb.AppendLine("```");
            sb.AppendLine();
        }

        return sb.ToString();
    }

    /// <summary>
    /// 将BsonValue转换为可显示的值
    /// </summary>
    private static object? ConvertBsonValueForDisplay(LiteDB.BsonValue bsonValue)
    {
        return ConvertBsonValueForExport(bsonValue);
    }

    /// <summary>
    /// 将BsonValue转换为可导出的值
    /// </summary>
    private static object? ConvertBsonValueForExport(LiteDB.BsonValue bsonValue)
    {
        if (bsonValue == null || bsonValue.IsNull)
            return null;
        
        return bsonValue.Type switch
        {
            LiteDB.BsonType.String => bsonValue.AsString,
            LiteDB.BsonType.Int32 => bsonValue.AsInt32,
            LiteDB.BsonType.Int64 => bsonValue.AsInt64,
            LiteDB.BsonType.Double => bsonValue.AsDouble,
            LiteDB.BsonType.Boolean => bsonValue.AsBoolean,
            LiteDB.BsonType.DateTime => bsonValue.AsDateTime,
            LiteDB.BsonType.Document or LiteDB.BsonType.Array => System.Text.Json.JsonSerializer.Serialize(BsonValueToObject(bsonValue)),
            _ => bsonValue.ToString()
        };
    }

    /// <summary>
    /// 将BsonValue转换为普通.NET对象
    /// </summary>
    private static object? BsonValueToObject(LiteDB.BsonValue bsonValue)
    {
        if (bsonValue == null || bsonValue.IsNull) return null;
        
        return bsonValue.Type switch
        {
            LiteDB.BsonType.String => bsonValue.AsString,
            LiteDB.BsonType.Int32 => bsonValue.AsInt32,
            LiteDB.BsonType.Int64 => bsonValue.AsInt64,
            LiteDB.BsonType.Double => bsonValue.AsDouble,
            LiteDB.BsonType.Boolean => bsonValue.AsBoolean,
            LiteDB.BsonType.DateTime => bsonValue.AsDateTime,
            LiteDB.BsonType.Document => bsonValue.AsDocument.ToDictionary(kvp => kvp.Key, kvp => BsonValueToObject(kvp.Value)),
            LiteDB.BsonType.Array => bsonValue.AsArray.Select(BsonValueToObject).ToArray(),
            _ => bsonValue.ToString()
        };
    }

    private class ExportRecord
    {
        public string CombinationId { get; set; } = string.Empty;
        public bool IsSuccess { get; set; }
        public string GeneratedText { get; set; } = string.Empty;
        public string? FailureReason { get; set; }
        public decimal Cost { get; set; }
        public DateTime GeneratedAt { get; set; }
        public Dictionary<string, string> InputData { get; set; } = new();
        
        /// <summary>
        /// 结构化数据字段（当有结构化输出时）
        /// </summary>
        public Dictionary<string, object?> StructuredFields { get; set; } = new();
        
        /// <summary>
        /// 是否包含结构化数据
        /// </summary>
        public bool HasStructuredData { get; set; }
    }

    private static string SafeShortId(string? value)
    {
        if (string.IsNullOrEmpty(value)) return string.Empty;
        return value.Length > 8 ? value.Substring(0, 8) : value;
    }

    /// <summary>
    /// 初始化 SignalR 连接
    /// </summary>
    private async Task InitializeSignalRConnection()
    {
        try
        {
            if (string.IsNullOrEmpty(TaskId))
                return;

            hubConnection = new HubConnectionBuilder()
                .WithUrl(Navigation.ToAbsoluteUri("/reasoning-progress-hub"))
                .WithAutomaticReconnect()
                .Build();

            // 订阅进度更新事件
            hubConnection.On<string, ReasoningProgress>("ProgressUpdated", OnProgressUpdated);
            hubConnection.On<string, TransactionStatus, TransactionStatus>("StatusChanged", OnStatusChanged);

            var conn = hubConnection; // 局部引用，避免并发置空
            await conn.StartAsync();
            
            // 订阅当前实例的进度更新
            await conn.SendAsync("SubscribeToInstance", TaskId);

            Snackbar.Add("实时进度更新已启用", Severity.Info);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"连接实时更新服务失败: {ex.Message}", Severity.Warning);
        }
    }

    /// <summary>
    /// 处理进度更新事件
    /// </summary>
    private async Task OnProgressUpdated(string instanceId, ReasoningProgress progress)
    {
        if (instanceId == TaskId)
        {
            try
            {
                currentProgress = progress;
                
                // 如果实例状态发生变化，同步更新本地实例对象
                if (instance != null && instance.Status != progress.Status)
                {
                    instance.Status = progress.Status;
                    if (progress.CompletedAt.HasValue && !instance.CompletedAt.HasValue)
                    {
                        instance.CompletedAt = progress.CompletedAt;
                    }
                }
                
                // 如果距离上次手动刷新超过30秒，或者状态发生了重大变化，则刷新实例数据
                var now = DateTime.UtcNow;
                var timeSinceLastRefresh = now - lastManualRefresh;
                var shouldRefreshInstance = timeSinceLastRefresh > TimeSpan.FromSeconds(30) ||
                                          (progress.Status is TransactionStatus.Completed or TransactionStatus.Failed);
                
                if (shouldRefreshInstance)
                {
                    await LoadInstanceDetail();
                    lastManualRefresh = now;
                }
                else
                {
                    // 只刷新UI，不重新加载数据
                    await InvokeAsync(StateHasChanged);
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"处理进度更新失败: {ex.Message}");
            }
        }
    }

    /// <summary>
    /// 处理状态变化事件
    /// </summary>
    private async Task OnStatusChanged(string instanceId, TransactionStatus oldStatus, TransactionStatus newStatus)
    {
        if (instanceId == TaskId)
        {
            try
            {
                // 更新本地实例状态
                if (instance != null)
                {
                    instance.Status = newStatus;
                    if (newStatus is TransactionStatus.Completed or TransactionStatus.Failed && !instance.CompletedAt.HasValue)
                    {
                        instance.CompletedAt = DateTime.UtcNow;
                    }
                }

                // 显示状态变化通知
                var statusText = GetStatusDisplayText(newStatus);
                var severity = GetSeverityForStatus(newStatus);
                Snackbar.Add($"任务状态变更: {statusText}", severity);

                await InvokeAsync(StateHasChanged);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"处理状态变化失败: {ex.Message}");
            }
        }
    }

    /// <summary>
    /// 获取状态显示文本
    /// </summary>
    private string GetStatusDisplayText(TransactionStatus status)
    {
        return status switch
        {
            TransactionStatus.Pending => "待处理",
            TransactionStatus.FetchingData => "获取数据中",
            TransactionStatus.CombiningData => "组合数据中",
            TransactionStatus.GeneratingOutputs => "生成输出中",
            TransactionStatus.Completed => "已完成",
            TransactionStatus.Failed => "执行失败",
            TransactionStatus.Paused => "已暂停",
            _ => "未知状态"
        };
    }

    /// <summary>
    /// 根据状态获取通知级别
    /// </summary>
    private Severity GetSeverityForStatus(TransactionStatus status)
    {
        return status switch
        {
            TransactionStatus.Completed => Severity.Success,
            TransactionStatus.Failed => Severity.Error,
            TransactionStatus.GeneratingOutputs => Severity.Info,
            TransactionStatus.Paused => Severity.Warning,
            _ => Severity.Normal
        };
    }

    /// <summary>
    /// 清理 SignalR 连接
    /// </summary>
    public async ValueTask DisposeAsync()
    {
        if (hubConnection is not null)
        {
            try
            {
                if (hubConnection.State == HubConnectionState.Connected && !string.IsNullOrEmpty(TaskId))
                {
                    await hubConnection.SendAsync("UnsubscribeFromInstance", TaskId);
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"取消订阅失败: {ex.Message}");
            }
            finally
            {
                await hubConnection.DisposeAsync();
            }
        }
    }
    
    private async Task RefreshInstanceProgress(string instanceId)
    {
        await ProgressManager.RefreshInstanceProgressAsync(instanceId);

        // 只有在没有实时连接时才手动刷新
        if (hubConnection?.State != HubConnectionState.Connected)
        {
            await LoadInstanceDetail();
        }
    }

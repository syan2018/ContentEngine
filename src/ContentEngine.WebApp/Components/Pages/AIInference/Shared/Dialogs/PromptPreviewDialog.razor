@using MudBlazor
@using ContentEngine.Core.DataPipeline.Models
@using ContentEngine.Core.Utils
@using ContentEngine.WebApp.Components.Shared.Cards

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.h6" Class="mb-3 d-flex align-center">
            <MudIcon Icon="@Icons.Material.Filled.TextSnippet" Class="mr-2" Color="Color.Primary" />
            Prompt预览
            @if (HasStructuredOutput)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Success" Class="ml-2">结构化输出</MudChip>
            }
        </MudText>
        
        <MudGrid Spacing="3">
            <!-- Prompt 内容 -->
            <MudItem>
                <PromptDisplayCard 
                    OriginalPrompt="@Content"
                    OutputFields="@(HasStructuredOutput ? OutputFields : null)"
                    ShowCard="false"
                    ShowStatistics="true" />
            </MudItem>
            
            <!-- 输出字段（如果有） -->
            @if (HasStructuredOutput && OutputFields?.Any() == true)
            {
                <MudItem>
                    <OutputFieldsCard 
                        Fields="@OutputFields"
                        Title="输出字段"
                        ShowStatistics="true" />
                </MudItem>
            }
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" 
                  StartIcon="@Icons.Material.Filled.ContentCopy"
                  OnClick="CopyToClipboard">
            复制
        </MudButton>
        <MudButton Color="Color.Primary" 
                  Variant="Variant.Filled" 
                  OnClick="Submit">
            关闭
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance? MudDialog { get; set; }
    [Parameter] public string Content { get; set; } = string.Empty;
    
    /// <summary>
    /// 是否启用结构化输出
    /// </summary>
    [Parameter] public bool HasStructuredOutput { get; set; } = false;
    
    /// <summary>
    /// 输出字段定义
    /// </summary>
    [Parameter] public List<FieldDefinition>? OutputFields { get; set; }

    private void Submit() => MudDialog?.Close(DialogResult.Ok(true));

    private async Task CopyToClipboard()
    {
        // 这里需要使用JavaScript来复制到剪贴板
        // 在实际实现中，可以通过IJSRuntime来调用JavaScript
        // 现在先简化处理
        await Task.CompletedTask;
        // TODO: 实现复制到剪贴板功能
    }
    
} 